# Credentials for the team AI gateway, baked into the app binary at compile
# time (option_env! in src-tauri/src/deepseek.rs). Copy this file to
# apps/screenpipe-app-tauri/.env.ai.local (gitignored — this repo is public,
# NEVER commit the real key) and fill in the value. The build scripts
# (scripts/dev/sp-build-mac-dev, scripts/dev/sp-build-mac-signed) source the
# .local file automatically; for a raw `bun run build:tauri:dev` export the
# variable yourself.
#
# Resolution order at runtime: AI-preset key -> DEEPSEEK_API_KEY env -> this
# baked key.
SCREENPIPE_DEEPSEEK_API_KEY="sk-..."
